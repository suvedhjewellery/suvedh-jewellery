{%- assign parent_titles = 'Women|Kids|Collections|Gifts' | split: '|' -%}
{%- for parent_title in parent_titles -%}
  {%- case parent_title -%}
    {%- when 'Women' -%}{%- assign child_rows = women_links | strip | newline_to_br | split: '<br />' -%}
    {%- when 'Kids' -%}{%- assign child_rows = kids_links | strip | newline_to_br | split: '<br />' -%}
    {%- when 'Collections' -%}{%- assign child_rows = collection_links | strip | newline_to_br | split: '<br />' -%}
    {%- when 'Gifts' -%}{%- assign child_rows = gift_links | strip | newline_to_br | split: '<br />' -%}
  {%- endcase -%}
  <li>
    <details id="Details-menu-drawer-suvedh-{{ parent_title | handleize }}">
      <summary class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
        {{ parent_title | escape }}
        <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </summary>
      <div class="menu-drawer__submenu has-submenu gradient motion-reduce" tabindex="-1">
        <div class="menu-drawer__inner-submenu">
          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
            <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
            {{ parent_title | escape }}
          </button>
          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
            {%- for child_row in child_rows -%}
              {%- assign child_parts = child_row | strip | split: '|' -%}
              <li><a href="{{ child_parts[1] }}" class="menu-drawer__menu-item link link--text list-menu__item focus-inset">{{ child_parts[0] | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </details>
  </li>
  {%- if parent_title == 'Collections' -%}
    <li><a href="{{ routes.collections_url }}/new-arrivals" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">New Arrivals</a></li>
    <li><a href="{{ routes.collections_url }}/best-sellers" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">Best Sellers</a></li>
  {%- endif -%}
{%- endfor -%}
<li><a href="/pages/about-us" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">About Us</a></li>