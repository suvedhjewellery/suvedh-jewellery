{%- liquid
  assign selected_variant = featured_product.selected_or_first_available_variant
  assign product_form_id = 'single-collection-product-form-' | append: section.id
  assign cleaned_description = featured_product.description | replace: '<p></p>', '' | replace: '<p>&nbsp;</p>', '' | strip
  assign short_description = cleaned_description | split: '</p>' | first
  if short_description contains '<p'
    assign short_description = short_description | append: '</p>'
  endif
  assign initial_media = selected_variant.featured_media | default: featured_product.featured_media
-%}
<div class="suvedh-single-collection-product{% if section.settings.enable_sticky_product_info %} suvedh-single-collection-product--sticky{% endif %}" data-single-collection-product>
  <nav class="suvedh-single-collection-product__breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span>{{ collection.title | escape }}</span></nav>
  <div class="suvedh-single-collection-product__media">
    <div class="suvedh-single-collection-product__main-media">
      <span class="suvedh-single-collection-product__sale{% unless selected_variant.compare_at_price > selected_variant.price %} hidden{% endunless %}" data-sale-badge>Sale</span>
      {%- if initial_media != blank -%}<button type="button" class="suvedh-single-collection-product__zoom-trigger" data-zoom-trigger data-media-id="{{ initial_media.id }}"{% unless section.settings.enable_image_zoom %} disabled{% endunless %} aria-label="Enlarge {{ initial_media.alt | default: featured_product.title | escape }}">{{ initial_media.preview_image | image_url: width: 1400 | image_tag: class: 'suvedh-single-collection-product__image', widths: '360, 540, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: initial_media.alt }}</button>{%- endif -%}
    </div>
    {%- if featured_product.media.size > 1 -%}<div class="suvedh-single-collection-product__thumbnails" aria-label="Product media">{%- for media in featured_product.media -%}{%- if media.preview_image != blank -%}<button type="button" class="suvedh-single-collection-product__thumbnail{% if media.id == initial_media.id %} is-active{% endif %}" data-media-id="{{ media.id }}" data-media-src="{{ media.preview_image | image_url: width: 1400 }}" data-media-zoom-src="{{ media.preview_image | image_url: width: 2400 }}" data-media-alt="{{ media.alt | default: featured_product.title | escape }}" aria-label="Show image {{ forloop.index }}">{{ media.preview_image | image_url: width: 180 | image_tag: widths: '90, 135, 180', sizes: '72px', loading: 'lazy', alt: media.alt }}</button>{%- endif -%}{%- endfor -%}</div>{%- endif -%}
  </div>
  <div class="suvedh-single-collection-product__info">
    <h1>{{ featured_product.title | escape }}</h1>
    <p class="suvedh-single-collection-product__sku{% if selected_variant.sku == blank %} hidden{% endif %}" data-variant-sku>SKU: <span>{{ selected_variant.sku | escape }}</span></p>
    {%- if section.settings.enable_viewer_badge -%}<p class="suvedh-single-collection-product__viewer"><span aria-hidden="true">&#128065;</span><strong>{{ section.settings.viewer_count }}</strong> {{ section.settings.viewer_message | escape }}</p>{%- endif -%}
    <div class="suvedh-single-collection-product__price" data-variant-price><span class="suvedh-single-collection-product__current-price">{{ selected_variant.price | money }}</span><s{% unless selected_variant.compare_at_price > selected_variant.price %} class="hidden"{% endunless %}>{{ selected_variant.compare_at_price | money }}</s>{%- if selected_variant.compare_at_price > selected_variant.price -%}{%- assign saving = selected_variant.compare_at_price | minus: selected_variant.price | times: 100.0 | divided_by: selected_variant.compare_at_price | round -%}<span class="suvedh-single-collection-product__discount">Save {{ saving }}%</span>{%- else -%}<span class="suvedh-single-collection-product__discount hidden"></span>{%- endif -%}</div>
    <p class="suvedh-single-collection-product__inventory" data-variant-inventory role="status">{% if selected_variant.available %}In stock{% else %}Sold out{% endif %}</p>
    <p class="suvedh-single-collection-product__tax">Inclusive of all taxes</p>
    {%- if short_description != blank -%}<div class="suvedh-single-collection-product__description rte">{{ short_description }}</div>{%- endif -%}
    <product-form class="suvedh-single-collection-product__actions" data-section-id="{{ section.id }}">
      {%- form 'product', featured_product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
        {%- unless featured_product.has_only_default_variant -%}<div class="suvedh-single-collection-product__variants" data-variant-options>{%- for option in featured_product.options_with_values -%}<div class="product-form__input product-form__input--dropdown"><label class="form__label" for="SingleOption-{{ section.id }}-{{ forloop.index0 }}">{{ option.name | escape }}</label><div class="select"><select class="select__select" id="SingleOption-{{ section.id }}-{{ forloop.index0 }}" data-option-position="{{ option.position }}">{%- for value in option.values -%}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value | escape }}</option>{%- endfor -%}</select><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></div></div>{%- endfor -%}</div>{%- endunless -%}
        <div class="product-form__input product-form__quantity"><label class="form__label" for="SingleQuantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label><quantity-input class="quantity"><button class="quantity__button" name="minus" type="button"><span class="visually-hidden">Decrease quantity</span><span class="svg-wrapper">{{ 'icon-minus.svg' | inline_asset_content }}</span></button><input class="quantity__input" type="number" name="quantity" id="SingleQuantity-{{ section.id }}" data-min="{{ selected_variant.quantity_rule.min }}" min="{{ selected_variant.quantity_rule.min }}"{% if selected_variant.quantity_rule.max != null %} data-max="{{ selected_variant.quantity_rule.max }}" max="{{ selected_variant.quantity_rule.max }}"{% endif %} step="{{ selected_variant.quantity_rule.increment }}" value="{{ selected_variant.quantity_rule.min }}"><button class="quantity__button" name="plus" type="button"><span class="visually-hidden">Increase quantity</span><span class="svg-wrapper">{{ 'icon-plus.svg' | inline_asset_content }}</span></button></quantity-input></div>
        <input type="hidden" name="id" value="{{ selected_variant.id }}">
        <div class="product-form__error-message-wrapper" role="alert" hidden><span class="svg-wrapper">{{ 'icon-error.svg' | inline_asset_content }}</span><span class="product-form__error-message"></span></div>
        <button type="submit" name="add" class="product-form__submit button button--full-width"{% unless selected_variant.available %} disabled{% endunless %}><span>{% if selected_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>{%- render 'loading-spinner' -%}</button>
        <div class="suvedh-single-collection-product__dynamic-checkout{% unless selected_variant.available %} hidden{% endunless %}" data-dynamic-checkout>{{ form | payment_button }}</div>
      {%- endform -%}
    </product-form>
    <button type="button" class="suvedh-single-collection-product__wishlist" data-product-wishlist data-product-handle="{{ featured_product.handle | escape }}" data-product-title="{{ featured_product.title | escape }}" aria-label="Add {{ featured_product.title | escape }} to wishlist" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.7a5.5 5.5 0 0 0-7.8 0L12 5.8l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.5a5.5 5.5 0 0 0 0-7.8Z"/></svg><span data-wishlist-label>Add to Wishlist</span></button>
    {%- assign offer_blocks = section.blocks | where: 'type', 'offer' -%}{%- if section.settings.enable_offer_cards and offer_blocks.size > 0 -%}<section class="suvedh-single-collection-product__offers" aria-labelledby="CollectionOffers-{{ section.id }}"><h2 id="CollectionOffers-{{ section.id }}">Available offers</h2><div class="suvedh-single-collection-product__offer-grid">{%- for block in offer_blocks limit: 4 -%}{%- if block.settings.enabled -%}<article class="suvedh-single-collection-product__offer" {{ block.shopify_attributes }}><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.description | escape }}</p>{%- if block.settings.code != blank -%}<div><code>{{ block.settings.code | escape }}</code><button type="button" data-copy-code="{{ block.settings.code | escape }}" data-copy-label="{{ block.settings.copy_button_label | escape }}">{{ block.settings.copy_button_label | escape }}</button></div>{%- endif -%}</article>{%- endif -%}{%- endfor -%}</div></section>{%- endif -%}
    {%- if section.settings.enable_information_tabs -%}{%- assign info_labels = 'Description,Shipping & Returns,Jewellery Care,Product Details' | split: ',' -%}<section class="suvedh-single-collection-product__information" data-product-information><div class="suvedh-single-collection-product__tablist" role="tablist" aria-label="Product information">{%- for label in info_labels -%}<button type="button" role="tab" id="CollectionTab-{{ section.id }}-{{ forloop.index }}" aria-controls="CollectionPanel-{{ section.id }}-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">{{ label }}</button>{%- endfor -%}</div>{%- for label in info_labels -%}<div class="suvedh-single-collection-product__panel{% unless forloop.first %} is-hidden{% endunless %}" id="CollectionPanel-{{ section.id }}-{{ forloop.index }}" role="tabpanel" aria-labelledby="CollectionTab-{{ section.id }}-{{ forloop.index }}"><button class="suvedh-single-collection-product__accordion-trigger" type="button" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="CollectionPanelContent-{{ section.id }}-{{ forloop.index }}">{{ label }}<span aria-hidden="true">+</span></button><div class="suvedh-single-collection-product__panel-content rte" id="CollectionPanelContent-{{ section.id }}-{{ forloop.index }}"{% unless forloop.first %} hidden{% endunless %}>{%- case forloop.index -%}{%- when 1 -%}{{ featured_product.description }}{%- when 2 -%}{{ section.settings.shipping_returns }}{%- when 3 -%}{{ section.settings.jewellery_care }}{%- when 4 -%}<dl class="suvedh-single-collection-product__details">{%- if featured_product.type != blank -%}<div><dt>Product type</dt><dd>{{ featured_product.type | escape }}</dd></div>{%- endif -%}{%- if featured_product.vendor != blank -%}<div><dt>Vendor</dt><dd>{{ featured_product.vendor | escape }}</dd></div>{%- endif -%}<div data-product-detail-sku{% if selected_variant.sku == blank %} class="hidden"{% endif %}><dt>SKU</dt><dd>{{ selected_variant.sku | escape }}</dd></div>{%- assign detail_keys = 'material,purity,silver_weight,stone_type,stone_colour,adjustable,package_contents' | split: ',' -%}{%- for key in detail_keys -%}{%- assign detail = featured_product.metafields.custom[key] -%}{%- if detail != blank -%}<div><dt>{{ key | replace: '_', ' ' | capitalize }}</dt><dd>{{ detail | metafield_tag }}</dd></div>{%- endif -%}{%- endfor -%}</dl>{%- endcase -%}</div></div>{%- endfor -%}</section>{%- endif -%}
    <div class="suvedh-single-collection-product__trust" aria-label="Purchase benefits"><div><span aria-hidden="true">◇</span><p>925 Sterling Silver</p></div><div><span aria-hidden="true">✓</span><p>Authenticity Certificate</p></div><div><span aria-hidden="true">♧</span><p>Free Shipping</p></div><div><span aria-hidden="true">↶</span><p>7-Day Returns</p></div></div>
    {%- if section.settings.enable_secure_checkout -%}<section class="suvedh-single-collection-product__payments"><h2>{{ section.settings.secure_checkout_heading | escape }}</h2><div>{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}</div></section>{%- endif -%}
  </div>
  {%- if section.settings.enable_image_zoom and featured_product.media.size > 0 -%}<div class="suvedh-single-collection-product__zoom" data-zoom-modal hidden role="dialog" aria-modal="true" aria-label="Product image viewer"><button type="button" class="suvedh-single-collection-product__zoom-close" data-zoom-close aria-label="Close image viewer">&times;</button><button type="button" class="suvedh-single-collection-product__zoom-nav is-previous" data-zoom-previous aria-label="Previous image">&#8249;</button><img data-zoom-image src="{{ initial_media.preview_image | image_url: width: 2400 }}" alt="{{ initial_media.alt | default: featured_product.title | escape }}" width="2400" height="2400"><button type="button" class="suvedh-single-collection-product__zoom-nav is-next" data-zoom-next aria-label="Next image">&#8250;</button></div>{%- endif -%}
  <script type="application/json" data-product-variants>{{ featured_product.variants | json }}</script>
  <div class="hidden" data-variant-render-data>{%- for variant in featured_product.variants -%}{%- assign variant_saving = 0 -%}{%- if variant.compare_at_price > variant.price -%}{%- assign variant_saving = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round -%}{%- endif -%}<span data-variant-id="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}" data-saving="{{ variant_saving }}" data-media-id="{{ variant.featured_media.id }}" data-media-src="{% if variant.featured_media %}{{ variant.featured_media.preview_image | image_url: width: 1400 }}{% endif %}" data-min="{{ variant.quantity_rule.min }}" data-max="{{ variant.quantity_rule.max }}" data-step="{{ variant.quantity_rule.increment }}"></span>{%- endfor -%}</div>
</div>
