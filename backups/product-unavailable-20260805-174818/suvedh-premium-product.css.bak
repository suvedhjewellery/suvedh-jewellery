.suvedh-product-page{--suvedh-gold:#9a7441;--suvedh-blush:#fbf5f3;--suvedh-line:rgba(52,40,27,.14);--suvedh-ink:#241f1a}.suvedh-product-page .page-width{max-width:144rem}.suvedh-product-page .product{column-gap:clamp(3rem,6vw,9rem)}.suvedh-product-page .product__media-wrapper .global-media-settings{background:var(--suvedh-media-bg,#faf9f7);border:1px solid var(--suvedh-line);border-radius:.8rem}.suvedh-product-page .product__media img{object-fit:contain}.suvedh-product-page .product__info-container{max-width:58rem}.suvedh-product-page .product__column-sticky{top:12rem}.suvedh-product-page__breadcrumb{display:flex;flex-wrap:wrap;gap:.8rem;margin:0 0 2.2rem;color:rgba(36,31,26,.6);font-size:1.2rem}.suvedh-product-page__breadcrumb a{color:inherit;text-decoration:none}.suvedh-product-page__breadcrumb a:hover{text-decoration:underline}.suvedh-product-page__sku,.suvedh-product-page__viewer{margin:.5rem 0;color:rgba(36,31,26,.62);font-size:1.2rem;letter-spacing:.04em}.suvedh-product-page .product__title h1{color:var(--suvedh-ink);font-family:var(--font-heading-family);font-size:clamp(2.8rem,3vw,4.2rem);line-height:1.15}.suvedh-product-page .price--large{color:var(--suvedh-gold);font-size:2.4rem}.suvedh-product-page .product-form__submit{min-height:5.6rem;border-radius:.3rem}.suvedh-product-page .product-form__submit:focus-visible,.suvedh-product-page button:focus-visible,.suvedh-product-page a:focus-visible{outline:2px solid var(--suvedh-gold);outline-offset:3px}.suvedh-product-page__offers,.suvedh-product-page__information,.suvedh-product-page__payments{margin-top:3rem;border-top:1px solid var(--suvedh-line);padding-top:2.4rem}.suvedh-product-page__offers>h2,.suvedh-product-page__payments h2{margin:0 0 1.4rem;font-family:var(--font-heading-family);font-size:1.8rem}.suvedh-product-page__offer-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.suvedh-product-page__offer{padding:1.5rem;background:var(--suvedh-blush);border:1px solid rgba(154,116,65,.18);border-radius:.7rem}.suvedh-product-page__offer h3{margin:0 0 .8rem;font-size:1.4rem}.suvedh-product-page__offer p{margin:.5rem 0}.suvedh-product-page__offer code{font-family:inherit;font-weight:700;letter-spacing:.08em}.suvedh-product-page__offer button{margin-left:1rem;padding:.2rem .7rem;background:transparent;border:1px solid var(--suvedh-line);border-radius:.3rem;cursor:pointer}.suvedh-product-page__offer small{display:block;margin-top:.6rem;color:rgba(36,31,26,.62)}.suvedh-product-page__tablist{display:flex;border-bottom:1px solid var(--suvedh-line);overflow-x:auto}.suvedh-product-page__tablist button{flex:1;padding:1.2rem .6rem;background:none;border:0;border-bottom:2px solid transparent;color:inherit;white-space:nowrap;cursor:pointer}.suvedh-product-page__tablist button[aria-selected=true]{border-color:var(--suvedh-gold);color:var(--suvedh-gold)}.suvedh-product-page__panel{padding:1.8rem 0}.suvedh-product-page__panel.is-hidden{display:none}.suvedh-product-page__accordion-trigger{display:none}.suvedh-product-page__details{margin:0}.suvedh-product-page__details div{display:grid;grid-template-columns:1fr 1.5fr;gap:1rem;padding:.8rem 0;border-bottom:1px solid var(--suvedh-line)}.suvedh-product-page__details dd{margin:0}.suvedh-product-page__benefits{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:3rem}.suvedh-product-page__benefits>div,.suvedh-product-page__benefits>a{display:flex;align-items:center;gap:.8rem;padding:1.2rem;border:1px solid var(--suvedh-line)}.suvedh-product-page__benefits span{color:var(--suvedh-gold);font-size:2rem}.suvedh-product-page__benefits p,.suvedh-product-page__benefits small{display:block;margin:0}.suvedh-product-page__payments svg{width:3.8rem;height:2.4rem;margin:0 .4rem .4rem 0}.suvedh-product-page .suvedh-sticky-atc{padding-bottom:calc(1.2rem + env(safe-area-inset-bottom));z-index:35}@media(max-width:749px){.suvedh-product-page .product{display:block}.suvedh-product-page .product__info-wrapper{padding-top:2.4rem}.suvedh-product-page__offer-grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}.suvedh-product-page__offer{min-width:82%;scroll-snap-align:start}.suvedh-product-page__tablist{display:none}.suvedh-product-page__panel,.suvedh-product-page__panel.is-hidden{display:block;padding:0;border-bottom:1px solid var(--suvedh-line)}.suvedh-product-page__accordion-trigger{display:flex;width:100%;justify-content:space-between;padding:1.6rem 0;background:none;border:0;color:inherit;text-align:left}.suvedh-product-page__panel-content{padding:0 0 1.6rem}.suvedh-product-page__benefits{grid-template-columns:repeat(2,1fr)}.suvedh-product-page__benefits>div,.suvedh-product-page__benefits>a{align-items:flex-start}.suvedh-product-page .suvedh-sticky-atc{padding-right:1.2rem;padding-left:1.2rem}.suvedh-product-page .suvedh-sticky-atc .button{min-width:12rem}}
.suvedh-product-page__short-description{margin:1.6rem 0;color:rgba(36,31,26,.78)}
.suvedh-product-page__short-description>:first-child{margin-top:0}.suvedh-product-page__short-description>:last-child{margin-bottom:0}
.suvedh-product-page__discount{margin:1.6rem 0;padding:1.4rem 1.6rem;background:var(--discount-bg);color:var(--discount-color);border:1px solid var(--suvedh-line);border-radius:.7rem}
.suvedh-product-page__discount p{margin:0}.suvedh-product-page__discount small{display:block;margin-top:.5rem}.suvedh-product-page__discount code{font:inherit;font-weight:700;letter-spacing:.06em}
.suvedh-product-page .product-form__input--suvedh-color{display:flex;flex-wrap:wrap;gap:1rem;max-width:100%}.suvedh-product-page .product-form__input--suvedh-color legend{width:100%}
.suvedh-product-page .product-form__input--suvedh-color input+label{display:inline-flex;align-items:center;gap:.7rem;margin:0;padding:.4rem .8rem .4rem .4rem;border:1px solid var(--swatch-border);border-radius:999px;background:transparent;color:inherit}
.suvedh-product-page .product-form__input--suvedh-color input:checked+label{border:2px solid var(--selected-swatch-border);padding:.3rem .7rem .3rem .3rem}.suvedh-product-page .product-form__input--suvedh-color input.disabled+label{opacity:.4;text-decoration:line-through}
.suvedh-product-page__swatch{display:block;width:var(--swatch-size);height:var(--swatch-size);flex:none;border:1px solid rgba(0,0,0,.15);border-radius:50%;background:var(--swatch-color,#d8d3cd) center/cover}
@media(max-width:749px){.suvedh-product-page .product-form__buttons,.suvedh-product-page .shopify-payment-button{width:100%}.suvedh-product-page .product-form__input--suvedh-color{overflow:visible}.suvedh-product-page__discount{max-width:100%}}
.suvedh-product-page__faq{margin-top:3rem;border-top:1px solid var(--suvedh-line);padding-top:2.4rem}.suvedh-product-page__faq h2{margin:0 0 1rem;font-size:1.8rem}.suvedh-product-page__faq details{border-bottom:1px solid var(--suvedh-line)}.suvedh-product-page__faq summary{display:flex;justify-content:space-between;gap:2rem;padding:1.5rem 0;cursor:pointer;list-style:none}.suvedh-product-page__faq details>div{padding:0 0 1.5rem}.suvedh-product-page__discount button{margin-left:.6rem;padding:.25rem .7rem;border:1px solid currentColor;border-radius:.3rem;background:transparent;color:inherit;cursor:pointer}@media(max-width:749px){.suvedh-product-page{padding-top:var(--suvedh-mobile-spacing)!important}}

.suvedh-product-page__benefits>a{color:inherit;text-decoration:none}.suvedh-product-page .product__title h1{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:3}
.suvedh-product-page__saving{margin:.4rem 0;color:var(--suvedh-gold);font-size:1.2rem;font-weight:600}

.suvedh-product-page{padding-block:var(--suvedh-desktop-spacing,24px)}.suvedh-product-page__viewer{display:inline-flex;align-items:center;padding:.55rem .9rem;border:1px solid rgba(154,116,65,.25);border-radius:999px;background:var(--suvedh-blush);color:#6f3150}.suvedh-product-page__benefits svg{display:block;width:2.4rem;height:2.4rem}.suvedh-product-page__payments>div{display:flex;flex-wrap:wrap;gap:.6rem}.suvedh-product-page__offer button,.suvedh-product-page__accordion-trigger{min-height:44px}.suvedh-product-page .shopify-payment-button__button,.suvedh-product-page .product-form__submit{width:100%;min-height:44px}@media(max-width:989px){.suvedh-product-page .product__column-sticky{position:static;top:auto}}@media(max-width:749px){.suvedh-product-page{max-width:100%;overflow-x:clip;padding-top:var(--suvedh-mobile-spacing,20px);padding-bottom:calc(var(--suvedh-mobile-spacing,20px) + env(safe-area-inset-bottom))}.suvedh-product-page .product__media-wrapper{width:100%;max-width:100%}.suvedh-product-page .product-form__input--suvedh-color{display:flex;flex-wrap:wrap}.suvedh-product-page__offer-grid{max-width:100%;overscroll-behavior-inline:contain}.suvedh-product-page__payments svg{margin:0}.suvedh-product-page .quantity__button,.suvedh-product-page .quantity__input{min-width:44px;min-height:44px}}.suvedh-product-page__viewer{gap:.45rem;border-color:rgba(154,116,65,.35);background:rgba(154,116,65,.08);color:var(--suvedh-gold);letter-spacing:0}
.suvedh-product-page__wishlist{display:flex;align-items:center;justify-content:center;gap:.8rem;width:100%;min-height:4.8rem;margin-top:1rem;padding:0;border:1px solid var(--suvedh-gold);border-radius:.3rem;background:transparent;color:var(--suvedh-ink);font:inherit;cursor:pointer}
.suvedh-product-page__wishlist svg{width:2rem;height:2rem;fill:transparent;stroke:currentColor;stroke-width:1.4}
.suvedh-product-page__wishlist[aria-pressed=true] svg{fill:var(--suvedh-gold);stroke:var(--suvedh-gold)}
.suvedh-product-page__offer{background:var(--offer-background,var(--suvedh-blush));color:var(--offer-text,var(--suvedh-ink))}
.suvedh-product-page__offer>img{display:block;width:2.4rem;height:2.4rem;margin-bottom:.8rem;object-fit:contain}
.suvedh-product-page__offer button{color:inherit;border-color:currentColor}