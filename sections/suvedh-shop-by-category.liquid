{%- style -%}
  #SuvedhCategories-{{ section.id }} {
    --category-columns: {{ section.settings.columns_desktop }};
    --category-mobile-width: {{ section.settings.mobile_card_width }}%;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #SuvedhCategories-{{ section.id }} .suvedh-categories__header {
    max-width: 68rem;
    margin: 0 auto 3rem;
    text-align: center;
  }

  #SuvedhCategories-{{ section.id }} .suvedh-categories__heading { margin: 0; }

  #SuvedhCategories-{{ section.id }} .suvedh-categories__intro {
    margin: 1rem 0 0;
    color: rgba(var(--color-foreground), 0.7);
  }

  #SuvedhCategories-{{ section.id }} .suvedh-categories__list {
    display: flex;
    gap: 1.6rem;
    margin: 0;
    padding: 0 1.5rem 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 1.5rem;
    list-style: none;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  #SuvedhCategories-{{ section.id }} .suvedh-category {
    flex: 0 0 var(--category-mobile-width);
    min-width: 0;
    scroll-snap-align: start;
  }

  #SuvedhCategories-{{ section.id }} .suvedh-category__link {
    display: block;
    color: rgb(var(--color-foreground));
    text-decoration: none;
  }

  #SuvedhCategories-{{ section.id }} .suvedh-category__media {
    position: relative;
    overflow: hidden;
    border: 0.1rem solid rgba(176, 141, 87, 0.2);
    border-radius: 50%;
    background: rgba(var(--color-foreground), 0.04);
    transition: border-color 300ms ease, transform 350ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 350ms ease;
  }

  #SuvedhCategories-{{ section.id }} .suvedh-category__media--square { aspect-ratio: 1 / 1; }
  #SuvedhCategories-{{ section.id }} .suvedh-category__media--portrait { aspect-ratio: 1 / 1; }
  #SuvedhCategories-{{ section.id }} .suvedh-category__media--landscape { aspect-ratio: 1 / 1; }

  #SuvedhCategories-{{ section.id }} .suvedh-category__image,
  #SuvedhCategories-{{ section.id }} .suvedh-category__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  #SuvedhCategories-{{ section.id }} .suvedh-category__content {
    padding-top: 1.6rem;
    text-align: center;
  }

  #SuvedhCategories-{{ section.id }} .suvedh-category__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: calc(var(--font-heading-scale) * 1.8rem);
    letter-spacing: 0.04em;
  }

  #SuvedhCategories-{{ section.id }} .suvedh-category__subtitle {
    margin: 0.5rem 0 0;
    color: rgba(var(--color-foreground), 0.65);
    font-size: 1.3rem;
    letter-spacing: 0.04em;
  }

  #SuvedhCategories-{{ section.id }} .suvedh-category__link:focus-visible {
    outline: 0.2rem solid rgb(var(--color-foreground));
    outline-offset: 0.4rem;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    #SuvedhCategories-{{ section.id }} .suvedh-category__link:hover .suvedh-category__media { border-color: #b08d57; box-shadow: 0 1.2rem 3rem rgba(17, 17, 17, 0.08); transform: translateY(-0.4rem); }

    #SuvedhCategories-{{ section.id }} .suvedh-category--zoom .suvedh-category__link:hover .suvedh-category__image {
      transform: scale(1.045);
    }

    #SuvedhCategories-{{ section.id }} .suvedh-category--lift .suvedh-category__link {
      transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    #SuvedhCategories-{{ section.id }} .suvedh-category--lift .suvedh-category__link:hover {
      transform: translateY(-0.6rem);
    }
  }

  @media screen and (min-width: 750px) {
    #SuvedhCategories-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #SuvedhCategories-{{ section.id }} .suvedh-categories__header { margin-bottom: 4rem; }

    #SuvedhCategories-{{ section.id }} .suvedh-categories__list {
      display: grid;
      grid-template-columns: repeat(var(--category-columns), minmax(0, 22rem));
      justify-content: center;
      gap: clamp(3rem, 6vw, 8rem);
      padding: 0;
      overflow: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #SuvedhCategories-{{ section.id }} .suvedh-category__image,
    #SuvedhCategories-{{ section.id }} .suvedh-category__link { transition: none; }
  }
{%- endstyle -%}

<section
  id="SuvedhCategories-{{ section.id }}"
  class="suvedh-categories color-{{ section.settings.color_scheme }} gradient"
  aria-labelledby="SuvedhCategoriesHeading-{{ section.id }}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <header class="suvedh-categories__header">
        {%- if section.settings.heading != blank -%}
          <h2 id="SuvedhCategoriesHeading-{{ section.id }}" class="suvedh-categories__heading {{ section.settings.heading_size }} inline-richtext">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="suvedh-categories__intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    <ul class="suvedh-categories__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign category_collection = block.settings.collection
          assign category_heading = block.settings.heading | default: category_collection.title
          assign category_key = category_heading | strip | downcase
          assign category_asset = blank
          assign category_handle = category_key | handleize
          case category_key
            when 'rings'
              assign category_asset = 'suvedh-category-rings.webp.png'
              assign category_handle = 'women-rings'
            when 'earrings'
              assign category_asset = 'suvedh-category-earrings.webp.png'
              assign category_handle = 'women-earrings'
            when 'studs'
              assign category_asset = 'suvedh-category-studs.webp.png'
              assign category_handle = 'studs'
            when 'kids earrings'
              assign category_asset = 'suvedh-category-kids.webp.png'
              assign category_handle = 'kids-earrings'
            when 'divine pendants'
              assign category_asset = 'suvedh-category-divine-pendants.webp.png'
              assign category_handle = 'divine-pendants'
            when 'necklaces'
              assign category_asset = 'suvedh-category-charms.webp.png'
              assign category_handle = 'women-necklaces'
            when 'charms'
              assign category_asset = 'suvedh-category-charms.webp.png'
              assign category_handle = 'women-charms'
            when 'pendants'
              assign category_asset = 'suvedh-category-charms.webp.png'
              assign category_handle = 'pendants'
            when 'bracelets'
              assign category_asset = 'suvedh-category-bracelets.webp.png'
              assign category_handle = 'women-bracelets'
            when 'anklets'
              assign category_asset = 'suvedh-category-ankelets.webp.png'
              assign category_handle = 'women-anklets'
            when 'ankelets'
              assign category_asset = 'suvedh-category-ankelets.webp.png'
              assign category_handle = 'women-anklets'
            when 'toe rings'
              assign category_asset = 'suvedh-category-toe-rings.webp.png'
              assign category_handle = 'women-toe-rings'
            when 'kids'
              assign category_asset = 'suvedh-category-kids.webp.png'
              assign category_handle = 'kids'
            when 'gifts'
              assign category_asset = 'suvedh-category-gifts.webp.png'
              assign category_handle = 'gifts'
          endcase
          assign coming_soon_label = blank
          assign resolved_category_collection = category_collection | default: collections[category_handle]
          assign is_available_category = false
          if category_key == 'kids earrings' or category_key == 'studs' or category_key == 'divine pendants' or category_key == 'anklets' or category_key == 'ankelets' or category_key == 'kids kadas' or category_key == "men's rakhis" or category_key == 'kids rakhis'
            assign is_available_category = true
          endif
          if is_available_category == false and resolved_category_collection == blank or is_available_category == false and resolved_category_collection.all_products_count == 0
            assign coming_soon_label = category_heading
          endif
          assign category_image = block.settings.custom_image
          if category_image == blank and category_key == 'kids earrings' or category_image == blank and category_key == 'divine pendants'
            assign category_image = resolved_category_collection.products.first.featured_image
          endif
          assign image_alt = category_image.alt | default: category_heading
          assign image_sizes = '(min-width: 1200px) calc((1200px - 100px) / ' | append: section.settings.columns_desktop | append: '), (min-width: 750px) calc((100vw - 80px) / ' | append: section.settings.columns_desktop | append: '), ' | append: section.settings.mobile_card_width | append: 'vw'
        -%}
        <li class="suvedh-category suvedh-category--{{ block.settings.hover_animation }}" {{ block.shopify_attributes }}>
          <a
            class="suvedh-category__link"
            {% if coming_soon_label != blank %}
              href="{{ routes.all_products_collection_url }}?view=coming-soon&amp;category={{ coming_soon_label | url_encode }}"
            {% elsif resolved_category_collection != blank %}
              href="{{ resolved_category_collection.url }}"
            {% else %}
              href="{{ routes.collections_url }}/{{ category_handle }}"
            {% endif %}
          >
            <div class="suvedh-category__media suvedh-category__media--{{ block.settings.image_ratio }}">
              {%- if category_image != blank -%}
                {{
                  category_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'suvedh-category__image',
                    loading: 'lazy',
                    widths: '240, 360, 480, 600, 750, 900, 1200',
                    sizes: image_sizes,
                    alt: image_alt
                }}
              {%- elsif category_asset != blank -%}
                <img
                  class="suvedh-category__image"
                  src="{{ category_asset | asset_url }}"
                  alt="{{ category_heading | escape }}"
                  loading="lazy"
                  width="1200"
                  height="1200"
                  onerror="this.hidden=true;this.nextElementSibling.hidden=false"
                >
                <span class="suvedh-category__placeholder placeholder-svg" hidden aria-label="Artwork asset missing: {{ category_asset | escape }}">
                  {{- category_heading | escape -}}
                </span>
              {%- elsif category_collection.featured_image != blank -%}
                {{
                  category_collection.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'suvedh-category__image',
                    loading: 'lazy',
                    widths: '240, 360, 480, 600, 750, 900, 1200',
                    sizes: image_sizes,
                    alt: category_heading
                }}
              {%- else -%}
                <span class="suvedh-category__placeholder placeholder-svg" aria-label="Category artwork not configured">
                  {{- category_heading | default: 'Collection' | escape -}}
                </span>
              {%- endif -%}
            </div>
            <div class="suvedh-category__content">
              <h3 class="suvedh-category__title">{{ category_heading | default: 'Collection' | escape }}</h3>
              {%- if block.settings.subtitle != blank -%}
                <p class="suvedh-category__subtitle">{{ block.settings.subtitle | escape }}</p>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "SUVEDH shop by category",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 6, "step": 1, "label": "Desktop columns", "default": 4 },
    { "type": "range", "id": "mobile_card_width", "min": 60, "max": 90, "step": 5, "unit": "%", "label": "Mobile card width", "default": 75 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image" },
        { "type": "text", "id": "heading", "label": "Custom heading" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Image aspect ratio",
          "options": [
            { "value": "square", "label": "Square" },
            { "value": "portrait", "label": "Portrait" },
            { "value": "landscape", "label": "Landscape" }
          ],
          "default": "portrait"
        },
        {
          "type": "select",
          "id": "hover_animation",
          "label": "Hover animation",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "zoom", "label": "Subtle zoom" },
            { "value": "lift", "label": "Gentle lift" }
          ],
          "default": "zoom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SUVEDH shop by category",
      "blocks": [
        { "type": "category", "settings": { "heading": "Rings" } },
        { "type": "category", "settings": { "heading": "Earrings" } },
        { "type": "category", "settings": { "heading": "Kids Earrings" } },
        { "type": "category", "settings": { "heading": "Divine Pendants" } },
        { "type": "category", "settings": { "heading": "Bracelets" } },
        { "type": "category", "settings": { "heading": "Anklets" } },
        { "type": "category", "settings": { "heading": "Toe Rings" } }
      ]
    }
  ]
}
{% endschema %}
