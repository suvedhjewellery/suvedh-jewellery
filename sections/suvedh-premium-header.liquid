{{ 'suvedh-premium-header.css' | asset_url | stylesheet_tag }}
{{ 'component-menu-drawer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign resolved_menu = section.settings.menu
  assign use_suvedh_fallback_menu = false
  if resolved_menu == blank or resolved_menu.links == blank
    assign resolved_menu = linklists['main-menu']
  endif
  if resolved_menu == blank or resolved_menu.links == blank
    assign use_suvedh_fallback_menu = true
  endif
-%}
<header class="suvedh-header header-wrapper color-{{ section.settings.color_scheme }} gradient" data-suvedh-header>
  <div class="suvedh-header__inner page-width">
    {% render 'header-drawer', menu: resolved_menu, use_suvedh_fallback_menu: use_suvedh_fallback_menu %}

    <nav class="suvedh-header__nav" aria-label="Primary navigation">
      {%- unless use_suvedh_fallback_menu -%}
      {%- for link in resolved_menu.links -%}
        {%- if link.links != blank -%}
          <details class="suvedh-nav-item suvedh-nav-item--mega">
            <summary>{{ link.title | escape }}</summary>
            <div class="suvedh-mega">
              <div class="suvedh-mega__links">
                <p>Shop {{ link.title | escape }}</p>
                {%- for child_link in link.links -%}
                  <a href="{%- render 'suvedh-collection-link', parent: link.title, label: child_link.title, fallback: child_link.url -%}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>
                {%- endfor -%}
              </div>
            </div>
          </details>
        {%- else -%}
          <a href="{%- render 'suvedh-collection-link', label: link.title, fallback: link.url -%}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
      {%- else -%}
        {% render 'suvedh-navigation-fallback', context: 'desktop' %}
      {%- endunless -%}
    </nav>

    <a class="suvedh-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {%- assign header_logo = section.settings.logo -%}
      {% if header_logo != blank %}{{ header_logo | image_url: width: 600 | image_tag: widths: '180, 300, 450, 600', alt: shop.name, preload: true }}{% else %}<img src="{{ 'suvedh-logo-cropped.png' | asset_url }}" alt="{{ shop.name | escape }}" width="978" height="679" fetchpriority="high" decoding="async">{% endif %}
    </a>

    <div class="suvedh-header__actions">
      <a href="{{ routes.search_url }}" aria-label="Search">{{ 'icon-search.svg' | inline_asset_content }}<span>Search</span></a>
      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="customer-account-main-menu" class="suvedh-header__account">
          <button type="button" slot="signed-out-avatar" class="suvedh-header__account-button" aria-label="Sign in">
            {{ 'icon-account.svg' | inline_asset_content }}
            <span>Sign in</span>
          </button>
        </shopify-account>
      {% endif %}
      <a href="/pages/wishlist" aria-label="Wishlist"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.7a5.5 5.5 0 0 0-7.8 0L12 5.8l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.4 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg><span>Wishlist</span></a>
      <a href="{{ routes.cart_url }}" aria-label="Cart">{{ 'icon-cart-empty.svg' | inline_asset_content }}<span>Cart</span>{% if cart.item_count > 0 %}<b>{{ cart.item_count }}</b>{% endif %}</a>
    </div>
  </div>
</header>
<script>
(() => {
  const header = document.querySelector('[data-suvedh-header]');
  if (!header) return;

  const setScrolled = () => header.classList.toggle('is-scrolled', scrollY > 24);
  setScrolled();
  addEventListener('scroll', setScrolled, { passive: true });

  const navigation = header.querySelector('.suvedh-header__nav');
  if (!navigation) return;

  const dropdowns = [...navigation.querySelectorAll('.suvedh-nav-item--mega')];
  const closeDropdowns = (except) => {
    dropdowns.forEach((dropdown) => {
      if (dropdown !== except) dropdown.removeAttribute('open');
    });
  };

  dropdowns.forEach((dropdown) => {
    dropdown.addEventListener('pointerenter', () => {
      if (!matchMedia('(min-width: 990px)').matches) return;
      closeDropdowns(dropdown);
      dropdown.setAttribute('open', '');
    });

    dropdown.addEventListener('focusin', () => {
      if (!matchMedia('(min-width: 990px)').matches) return;
      closeDropdowns(dropdown);
      dropdown.setAttribute('open', '');
    });
  });

  navigation.querySelectorAll(':scope > a').forEach((link) => {
    link.addEventListener('pointerenter', () => closeDropdowns());
    link.addEventListener('focus', () => closeDropdowns());
  });

  navigation.addEventListener('pointerleave', () => closeDropdowns());
  navigation.addEventListener('focusout', (event) => {
    if (!navigation.contains(event.relatedTarget)) closeDropdowns();
  });

})();
</script>
{% schema %}
{
  "name": "SUVEDH premium header",
  "tag": "section",
  "class": "section-header suvedh-header-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color_scheme", "id": "menu_color_scheme", "label": "Menu color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "SUVEDH premium header" }]
}
{% endschema %}
