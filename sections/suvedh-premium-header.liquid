{{ 'suvedh-premium-header.css' | asset_url | stylesheet_tag }}
{{ 'component-menu-drawer.css' | asset_url | stylesheet_tag }}

<header class="suvedh-header header-wrapper color-{{ section.settings.color_scheme }} gradient" data-suvedh-header>
  <div class="suvedh-header__inner page-width">
    {% render 'header-drawer' %}

    <nav class="suvedh-header__nav" aria-label="Primary navigation">
      {%- for link in section.settings.menu.links -%}
        {%- if link.links != blank -%}
          <details class="suvedh-nav-item suvedh-nav-item--mega">
            <summary>{{ link.title | escape }}</summary>
            <div class="suvedh-mega">
              <div class="suvedh-mega__links">
                <p>Shop {{ link.title | escape }}</p>
                {%- for child_link in link.links -%}
                  <a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>
                {%- endfor -%}
              </div>
            </div>
          </details>
        {%- else -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <a class="suvedh-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {%- assign header_logo = section.settings.logo -%}
      {% if header_logo != blank %}{{ header_logo | image_url: width: 600 | image_tag: widths: '180, 300, 450, 600', alt: shop.name, preload: true }}{% else %}<img src="{{ 'suvedh-logo-clean.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1254" height="1254" fetchpriority="high" decoding="async">{% endif %}
    </a>

    <div class="suvedh-header__actions">
      <a href="{{ routes.search_url }}" aria-label="Search">{{ 'icon-search.svg' | inline_asset_content }}<span>Search</span></a>
      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="customer-account-main-menu" class="suvedh-header__account">
          <button type="button" slot="signed-out-avatar" class="suvedh-header__account-button" aria-label="Sign in">
            {{ 'icon-account.svg' | inline_asset_content }}
            <span>Sign in</span>
          </button>
        </shopify-account>
      {% endif %}
      <a href="/pages/wishlist" aria-label="Wishlist"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.7a5.5 5.5 0 0 0-7.8 0L12 5.8l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.4 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg><span>Wishlist</span></a>
      <a href="{{ routes.cart_url }}" aria-label="Cart">{{ 'icon-cart-empty.svg' | inline_asset_content }}<span>Cart</span>{% if cart.item_count > 0 %}<b>{{ cart.item_count }}</b>{% endif %}</a>
    </div>
  </div>
</header>
<script>
(() => {
  const header = document.querySelector('[data-suvedh-header]');
  if (!header) return;

  const setScrolled = () => header.classList.toggle('is-scrolled', scrollY > 24);
  setScrolled();
  addEventListener('scroll', setScrolled, { passive: true });

})();
</script>
{% schema %}
{
  "name": "SUVEDH premium header",
  "tag": "section",
  "class": "section-header suvedh-header-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color_scheme", "id": "menu_color_scheme", "label": "Menu color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "SUVEDH premium header" }]
}
{% endschema %}
