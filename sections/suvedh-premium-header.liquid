{{ 'suvedh-premium-header.css' | asset_url | stylesheet_tag }}
{{ 'component-menu-drawer.css' | asset_url | stylesheet_tag }}

<header class="suvedh-header header-wrapper color-{{ section.settings.color_scheme }} gradient" data-suvedh-header>
  <div class="suvedh-header__inner page-width">
    {% render 'header-drawer', suvedh_custom_navigation: true %}

    <nav class="suvedh-header__nav" aria-label="Primary navigation">
      <details class="suvedh-nav-item suvedh-nav-item--mega">
        <summary>Women</summary>
        <div class="suvedh-mega">
          <div class="suvedh-mega__links">
            <p>Shop Women</p>
            <a href="{{ routes.collections_url }}/rings">Rings</a><a href="{{ routes.collections_url }}/studs">Studs</a><a href="{{ routes.collections_url }}/earrings">Earrings</a>
            <a href="{{ routes.collections_url }}/necklaces">Necklaces</a><a href="{{ routes.collections_url }}/pendants">Pendants</a><a href="{{ routes.collections_url }}/bracelets">Bracelets</a>
            <a href="{{ routes.collections_url }}/bangles">Bangles</a><a href="{{ routes.collections_url }}/anklets">Anklets</a><a href="{{ routes.collections_url }}/toe-rings">Toe Rings</a>
            <a class="suvedh-mega__all" href="{{ routes.collections_url }}/women">View All</a>
          </div>
          <a class="suvedh-mega__feature" href="{{ routes.collections_url }}/women"><img src="{{ 'suvedh-hero-desktop.jpg' | asset_url }}" alt="SUVEDH fine silver jewellery for women" width="640" height="360" loading="lazy"><span>Fine silver, made for you</span></a>
        </div>
      </details>
      <details class="suvedh-nav-item suvedh-nav-item--mega">
        <summary>Men</summary>
        <div class="suvedh-mega">
          <div class="suvedh-mega__links">
            <p>Shop Men</p>
            {%- assign mens_rings = collections['mens-rings'] -%}
            {%- assign mens_chains = collections['mens-chains'] -%}
            {%- assign mens_bracelets = collections['mens-bracelets'] -%}
            {%- if mens_rings != blank -%}<a href="{{ mens_rings.url }}">Rings</a>{%- endif -%}
            {%- if mens_chains != blank -%}<a href="{{ mens_chains.url }}">Chains</a>{%- endif -%}
            {%- if mens_bracelets != blank -%}<a href="{{ mens_bracelets.url }}">Bracelets</a>{%- endif -%}
          </div>
        </div>
      </details>
      <details class="suvedh-nav-item suvedh-nav-item--mega">
        <summary>Kids</summary>
        <div class="suvedh-mega">
          <div class="suvedh-mega__links"><p>Shop Kids</p><a href="{{ routes.collections_url }}/kids-bracelets">Bracelets</a><a href="{{ routes.collections_url }}/kids-chains">Chains</a><a href="{{ routes.collections_url }}/kids-earrings">Earrings</a><a href="{{ routes.collections_url }}/kids-pendants">Pendants</a><a class="suvedh-mega__all" href="{{ routes.collections_url }}/kids-jewellery">View All</a></div>
          <a class="suvedh-mega__feature" href="{{ routes.collections_url }}/kids-jewellery"><img src="{{ 'suvedh-hero-mobile.jpg' | asset_url }}" alt="SUVEDH kids silver jewellery" width="360" height="420" loading="lazy"><span>Little keepsakes</span></a>
        </div>
      </details>
      {%- assign pendants_menu_link = blank -%}
      {%- for menu_link in section.settings.menu.links -%}
        {%- assign menu_handle = menu_link.title | handleize -%}
        {%- if menu_handle == 'pendants' -%}
          {%- assign pendants_menu_link = menu_link -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      <details class="suvedh-nav-item suvedh-nav-item--mega">
        <summary>Pendants</summary>
        <div class="suvedh-mega">
          <div class="suvedh-mega__links">
            <p>Shop Pendants</p>
            {%- if pendants_menu_link != blank and pendants_menu_link.links != blank -%}
              {%- for child_link in pendants_menu_link.links -%}
                <a href="{{ child_link.url }}">{{ child_link.title | escape }}</a>
              {%- endfor -%}
            {%- else -%}
              {%- assign women_pendants = collections['women-pendants'] -%}
              {%- assign divine_pendants = collections['divine-pendants'] -%}
              {%- assign kids_pendants = collections['kids-pendants'] -%}
              <a href="{% if women_pendants != blank %}{{ women_pendants.url }}{% else %}{{ routes.collections_url }}{% endif %}">Women Pendants</a>
              <a href="{% if divine_pendants != blank %}{{ divine_pendants.url }}{% else %}{{ routes.collections_url }}{% endif %}">Divine Pendants</a>
              <a href="{% if kids_pendants != blank %}{{ kids_pendants.url }}{% else %}{{ routes.collections_url }}{% endif %}">Kids Pendants</a>
            {%- endif -%}
          </div>
        </div>
      </details>
      {%- assign rakhi_menu_link = blank -%}
      {%- for menu_link in section.settings.menu.links -%}
        {%- if menu_link.title | handleize == 'rakhi' -%}
          {%- assign rakhi_menu_link = menu_link -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign rakhi_collection = collections['rakhi'] -%}
      {%- assign rakhi_link = blank -%}
      {%- if rakhi_menu_link != blank and rakhi_menu_link.links != blank -%}
        {%- for child_link in rakhi_menu_link.links -%}
          {%- if child_link.title | handleize == 'rakhi' -%}
            {%- assign rakhi_link = child_link -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      <details class="suvedh-nav-item suvedh-nav-item--mega">
        <summary>Rakhi</summary>
        <div class="suvedh-mega">
          <div class="suvedh-mega__links">
            <p>Shop Rakhi</p>
            <a href="{% if rakhi_link != blank %}{{ rakhi_link.url }}{% elsif rakhi_collection != blank %}{{ rakhi_collection.url }}{% elsif rakhi_menu_link != blank %}{{ rakhi_menu_link.url }}{% else %}{{ routes.collections_url }}/rakhi{% endif %}">Rakhi</a>
          </div>
        </div>
      </details>
      <a href="{{ routes.collections_url }}/new-arrivals">New Arrivals</a>
    </nav>

    <a class="suvedh-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {%- assign header_logo = section.settings.logo -%}
      {% if header_logo != blank %}{{ header_logo | image_url: width: 600 | image_tag: widths: '180, 300, 450, 600', alt: shop.name, preload: true }}{% else %}<img src="{{ 'suvedh-logo-clean.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1254" height="1254" fetchpriority="high" decoding="async">{% endif %}
    </a>

    <div class="suvedh-header__actions">
      <a href="{{ routes.search_url }}" aria-label="Search">{{ 'icon-search.svg' | inline_asset_content }}<span>Search</span></a>
      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="customer-account-main-menu" class="suvedh-header__account">
          <button type="button" slot="signed-out-avatar" class="suvedh-header__account-button" aria-label="Sign in">
            {{ 'icon-account.svg' | inline_asset_content }}
            <span>Sign in</span>
          </button>
        </shopify-account>
      {% endif %}
      <a href="/pages/wishlist" aria-label="Wishlist"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.7a5.5 5.5 0 0 0-7.8 0L12 5.8l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.4 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg><span>Wishlist</span></a>
      <a href="{{ routes.cart_url }}" aria-label="Cart">{{ 'icon-cart-empty.svg' | inline_asset_content }}<span>Cart</span>{% if cart.item_count > 0 %}<b>{{ cart.item_count }}</b>{% endif %}</a>
    </div>
  </div>
</header>
<script>
(() => { const header=document.querySelector('[data-suvedh-header]'); if(!header)return; const setScrolled=()=>header.classList.toggle('is-scrolled',scrollY>24); setScrolled(); addEventListener('scroll',setScrolled,{passive:true}); header.querySelectorAll('.suvedh-nav-item').forEach(item=>{item.addEventListener('mouseenter',()=>item.open=true);item.addEventListener('mouseleave',()=>item.open=false)}); })();
</script>
{% schema %}
{
  "name": "SUVEDH premium header",
  "tag": "section",
  "class": "section-header suvedh-header-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color_scheme", "id": "menu_color_scheme", "label": "Menu color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "SUVEDH premium header" }]
}
{% endschema %}
