{%- liquid
  assign current_path = request.path | downcase
-%}

<style type="text/css">
  .template-404 {
    padding-top: clamp(6rem, 10vw, 12rem);
    padding-bottom: clamp(7rem, 12vw, 14rem);
  }

  .template-404__content {
    max-width: 72rem;
    margin: 0 auto;
    text-align: center;
  }

  .template-404__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    color: rgb(var(--color-foreground));
  }

  .template-404__message {
    max-width: 58rem;
    margin: 1.8rem auto 0;
    color: rgba(var(--color-foreground), 0.72);
    line-height: 1.7;
  }

  .template-404__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem;
    margin-top: 3.2rem;
  }

  @media screen and (max-width: 749px) {
    .template-404__actions {
      flex-direction: column;
      align-items: stretch;
      max-width: 36rem;
      margin-right: auto;
      margin-left: auto;
    }

    .template-404__actions .button {
      width: 100%;
    }
  }
</style>

<div class="template-404 page-width page-margin">
  <div class="template-404__content">
    {%- if current_path contains '/products/' -%}
      <h1 class="template-404__title title">This product is currently unavailable.</h1>
      <p class="template-404__message">
        The product may be temporarily unavailable or no longer listed. Please explore our other jewellery collections.
      </p>
      <div class="template-404__actions">
        <a href="{{ routes.all_products_collection_url }}" class="button">Continue Shopping</a>
        <a href="{{ routes.collections_url }}/new-arrivals" class="button button--secondary">View New Arrivals</a>
      </div>
    {%- elsif current_path contains '/collections/' -%}
      <h1 class="template-404__title title">This collection is currently unavailable.</h1>
      <p class="template-404__message">
        The collection may be temporarily unavailable or has been moved. Please explore our available jewellery collections.
      </p>
      <div class="template-404__actions">
        <a href="{{ routes.all_products_collection_url }}" class="button">View All Products</a>
        <a href="{{ routes.collections_url }}/new-arrivals" class="button button--secondary">View New Arrivals</a>
      </div>
    {%- else -%}
      <p>{{ 'templates.404.subtext' | t }}</p>
      <h1 class="template-404__title title">{{ 'templates.404.title' | t }}</h1>
      <div class="template-404__actions">
        <a href="{{ routes.all_products_collection_url }}" class="button">
          {{ 'general.continue_shopping' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>
