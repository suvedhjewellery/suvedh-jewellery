{%- style -%}
  #SuvedhBenefits-{{ section.id }} {
    --benefit-columns: {{ section.settings.columns_desktop }};
    --benefit-icon-size: {{ section.settings.icon_size }}px;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #SuvedhBenefits-{{ section.id }} .suvedh-benefits__header {
    max-width: 68rem;
    margin: 0 auto 3rem;
    text-align: center;
  }

  #SuvedhBenefits-{{ section.id }} .suvedh-benefits__heading { margin: 0; }

  #SuvedhBenefits-{{ section.id }} .suvedh-benefits__intro {
    margin-top: 1rem;
    color: rgba(var(--color-foreground), 0.7);
  }

  #SuvedhBenefits-{{ section.id }} .suvedh-benefits__intro > * { margin: 0; }

  #SuvedhBenefits-{{ section.id }} .suvedh-benefits__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #SuvedhBenefits-{{ section.id }} .suvedh-benefit {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.text_alignment }};
    padding: 2rem 1.2rem;
    text-align: {{ section.settings.text_alignment }};
  }

  #SuvedhBenefits-{{ section.id }}.suvedh-benefits--separators .suvedh-benefit:nth-child(odd)::after {
    position: absolute;
    top: 20%;
    right: 0;
    bottom: 20%;
    width: 0.1rem;
    background: rgba(var(--color-foreground), 0.15);
    content: '';
  }

  #SuvedhBenefits-{{ section.id }} .suvedh-benefit__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--benefit-icon-size);
    height: var(--benefit-icon-size);
    margin-bottom: 1.4rem;
    color: rgb(var(--color-foreground));
  }

  #SuvedhBenefits-{{ section.id }} .suvedh-benefit__icon .svg-wrapper,
  #SuvedhBenefits-{{ section.id }} .suvedh-benefit__icon svg,
  #SuvedhBenefits-{{ section.id }} .suvedh-benefit__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #SuvedhBenefits-{{ section.id }} .suvedh-benefit__title {
    margin: 0;
    font-size: calc(var(--font-heading-scale) * 1.5rem);
    letter-spacing: 0.04em;
  }

  #SuvedhBenefits-{{ section.id }} .suvedh-benefit__text {
    max-width: 28rem;
    margin-top: 0.7rem;
    color: rgba(var(--color-foreground), 0.68);
    font-size: 1.3rem;
    line-height: 1.5;
  }

  #SuvedhBenefits-{{ section.id }} .suvedh-benefit__text > * { margin: 0; }

  @media screen and (min-width: 750px) {
    #SuvedhBenefits-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #SuvedhBenefits-{{ section.id }} .suvedh-benefits__list {
      grid-template-columns: repeat(var(--benefit-columns), minmax(0, 1fr));
    }

    #SuvedhBenefits-{{ section.id }} .suvedh-benefit { padding: 2.5rem 2rem; }

    #SuvedhBenefits-{{ section.id }}.suvedh-benefits--separators .suvedh-benefit:not(:last-child)::after {
      position: absolute;
      top: 20%;
      right: 0;
      bottom: 20%;
      width: 0.1rem;
      background: rgba(var(--color-foreground), 0.15);
      content: '';
    }

    #SuvedhBenefits-{{ section.id }}.suvedh-benefits--separators .suvedh-benefit:last-child::after { display: none; }
  }
{%- endstyle -%}

<section
  id="SuvedhBenefits-{{ section.id }}"
  class="suvedh-benefits color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_separators %} suvedh-benefits--separators{% endif %}"
  {% if section.settings.heading != blank %}aria-labelledby="SuvedhBenefitsHeading-{{ section.id }}"{% else %}aria-label="SUVEDH benefits"{% endif %}
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <header class="suvedh-benefits__header">
        {%- if section.settings.heading != blank -%}
          <h2 id="SuvedhBenefitsHeading-{{ section.id }}" class="suvedh-benefits__heading {{ section.settings.heading_size }} inline-richtext">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="suvedh-benefits__intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    <ul class="suvedh-benefits__list" role="list">
      {%- for block in section.blocks -%}
        <li class="suvedh-benefit" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' or block.settings.custom_icon != blank -%}
            <div class="suvedh-benefit__icon" aria-hidden="true">
              {%- if block.settings.custom_icon != blank -%}
                {{
                  block.settings.custom_icon
                  | image_url: width: 160
                  | image_tag:
                    loading: 'lazy',
                    widths: '48, 64, 96, 128, 160',
                    sizes: section.settings.icon_size,
                    alt: ''
                }}
              {%- else -%}
                <span class="svg-wrapper">
                  {%- case block.settings.icon -%}
                    {%- when 'checkmark' -%}{{- 'icon-checkmark.svg' | inline_asset_content -}}
                    {%- when 'lock' -%}{{- 'icon-lock.svg' | inline_asset_content -}}
                    {%- when 'return' -%}{{- 'icon-return.svg' | inline_asset_content -}}
                    {%- when 'truck' -%}{{- 'icon-truck.svg' | inline_asset_content -}}
                    {%- when 'star' -%}{{- 'icon-star.svg' | inline_asset_content -}}
                    {%- when 'box' -%}{{- 'icon-box.svg' | inline_asset_content -}}
                    {%- when 'heart' -%}{{- 'icon-heart.svg' | inline_asset_content -}}
                    {%- when 'padlock' -%}{{- 'icon-padlock.svg' | inline_asset_content -}}
                  {%- endcase -%}
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="suvedh-benefit__title">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="suvedh-benefit__text rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "SUVEDH benefits",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop columns", "default": 4 },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "icon_size", "min": 28, "max": 72, "step": 4, "unit": "px", "label": "Icon size", "default": 40 },
    { "type": "checkbox", "id": "show_separators", "label": "Show separators", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "checkmark", "label": "Checkmark" },
            { "value": "lock", "label": "Lock" },
            { "value": "return", "label": "Return" },
            { "value": "truck", "label": "Truck" },
            { "value": "star", "label": "Star" },
            { "value": "box", "label": "Box" },
            { "value": "heart", "label": "Heart" },
            { "value": "padlock", "label": "Padlock" }
          ],
          "default": "checkmark"
        },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon", "info": "Overrides the selected icon." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Benefit title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SUVEDH benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "checkmark", "heading": "Authentic 92.5 Silver" } },
        { "type": "benefit", "settings": { "icon": "lock", "heading": "Secure Payments" } },
        { "type": "benefit", "settings": { "icon": "return", "heading": "Easy Returns" } },
        { "type": "benefit", "settings": { "icon": "truck", "heading": "Pan-India Delivery" } }
      ]
    }
  ]
}
{% endschema %}
