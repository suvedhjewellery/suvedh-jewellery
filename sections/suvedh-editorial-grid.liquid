{%- style -%}#SuvedhEditorial-{{ section.id }}{padding:{{ section.settings.padding_top | times: 0.75 | round }}px 0 {{ section.settings.padding_bottom | times: 0.75 | round }}px}#SuvedhEditorial-{{ section.id }} .suvedh-editorial__head{text-align:center;max-width:65rem;margin:0 auto 4rem}#SuvedhEditorial-{{ section.id }} .suvedh-editorial__head h2{margin:0;font-weight:400}#SuvedhEditorial-{{ section.id }} .suvedh-editorial__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem}#SuvedhEditorial-{{ section.id }} .suvedh-editorial__card{position:relative;display:block;overflow:hidden;aspect-ratio:4/5;background:#f6f5f2;color:#fff;text-decoration:none}#SuvedhEditorial-{{ section.id }} .suvedh-editorial__card img,#SuvedhEditorial-{{ section.id }} .placeholder-svg{width:100%;height:100%;object-fit:cover;transition:transform .65s cubic-bezier(.22,1,.36,1)}#SuvedhEditorial-{{ section.id }} .suvedh-editorial__card:after{position:absolute;inset:42% 0 0;background:linear-gradient(transparent,rgba(0,0,0,.58));content:''}#SuvedhEditorial-{{ section.id }} .suvedh-editorial__content{position:absolute;z-index:1;right:1.6rem;bottom:1.6rem;left:1.6rem}#SuvedhEditorial-{{ section.id }} h3{margin:0;color:inherit;font-size:clamp(1.7rem,2.2vw,2.7rem);font-weight:400}#SuvedhEditorial-{{ section.id }} span{display:inline-block;margin-top:.7rem;border-bottom:1px solid #b08d57;font-size:1rem;letter-spacing:.13em;text-transform:uppercase}@media(hover:hover){#SuvedhEditorial-{{ section.id }} .suvedh-editorial__card:hover img{transform:scale(1.045)}}@media(min-width:750px){#SuvedhEditorial-{{ section.id }}{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px}#SuvedhEditorial-{{ section.id }} .suvedh-editorial__grid{grid-template-columns:repeat({{ section.settings.columns_desktop }},1fr);gap:2.4rem}#SuvedhEditorial-{{ section.id }} .suvedh-editorial__content{right:2.4rem;bottom:2.2rem;left:2.4rem}}{%- endstyle -%}
<section id="SuvedhEditorial-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient"><div class="page-width"><header class="suvedh-editorial__head"><h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>{% if section.settings.intro != blank %}<div class="rte">{{ section.settings.intro }}</div>{% endif %}</header><div class="suvedh-editorial__grid">{% for block in section.blocks %}<a class="suvedh-editorial__card" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %} {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900', sizes: '(min-width: 750px) 33vw, 50vw', alt: block.settings.title }}{% else %}<img src="{{ 'suvedh-hero-mobile.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" width="896" height="1792" loading="lazy">{% endif %}<div class="suvedh-editorial__content"><h3>{{ block.settings.title }}</h3>{% if block.settings.link_label != blank %}<span>{{ block.settings.link_label }}</span>{% endif %}</div></a>{% endfor %}</div></div></section>
{% schema %}{"name":"SUVEDH editorial grid","tag":"section","class":"section","max_blocks":6,"settings":[{"type":"inline_richtext","id":"heading","label":"Heading","default":"Shop by Occasion"},{"type":"richtext","id":"intro","label":"Introduction"},{"type":"select","id":"heading_size","label":"Heading size","options":[{"value":"h2","label":"Small"},{"value":"h1","label":"Medium"},{"value":"h0","label":"Large"}],"default":"h1"},{"type":"range","id":"columns_desktop","min":2,"max":6,"step":1,"label":"Desktop columns","default":3},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Top padding","default":64},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Bottom padding","default":64}],"blocks":[{"type":"card","name":"Card","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Collection"},{"type":"text","id":"link_label","label":"Link label","default":"Shop now"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"SUVEDH editorial grid","blocks":[{"type":"card"},{"type":"card"},{"type":"card"}]}]}{% endschema %}