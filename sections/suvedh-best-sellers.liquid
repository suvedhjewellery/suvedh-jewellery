{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_rating -%}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.quick_add == 'standard' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  #SuvedhBestSellers-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #SuvedhBestSellers-{{ section.id }} .suvedh-best-sellers__header {
    max-width: 68rem;
    margin: 0 auto 3rem;
    text-align: center;
  }

  #SuvedhBestSellers-{{ section.id }} .suvedh-best-sellers__heading { margin: 0; }

  #SuvedhBestSellers-{{ section.id }} .suvedh-best-sellers__subtitle {
    margin-top: 1rem;
    color: rgba(var(--color-foreground), 0.7);
  }

  #SuvedhBestSellers-{{ section.id }} .suvedh-best-sellers__subtitle > * { margin: 0; }

  #SuvedhBestSellers-{{ section.id }} .suvedh-best-sellers__view-all { margin-top: 3rem; }

  @media screen and (min-width: 750px) {
    #SuvedhBestSellers-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #SuvedhBestSellers-{{ section.id }} .suvedh-best-sellers__header { margin-bottom: 4rem; }
  }
{%- endstyle -%}

{%- liquid
  assign products_to_display = section.settings.collection.products_count | at_most: section.settings.products_to_show
  assign show_mobile_slider = false
  if products_to_display > 1
    assign show_mobile_slider = true
  endif
-%}

<section
  id="SuvedhBestSellers-{{ section.id }}"
  class="suvedh-best-sellers color-{{ section.settings.color_scheme }} gradient isolate"
  aria-labelledby="SuvedhBestSellersHeading-{{ section.id }}"
>
  <div class="page-width">
    <header class="suvedh-best-sellers__header">
      {%- if section.settings.heading != blank -%}
        <h2 id="SuvedhBestSellersHeading-{{ section.id }}" class="suvedh-best-sellers__heading {{ section.settings.heading_size }} inline-richtext">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <div class="suvedh-best-sellers__subtitle rte">{{ section.settings.subtitle }}</div>
      {%- endif -%}
    </header>

    <slider-component class="slider-mobile-gutter">
      <ul
        id="Slider-{{ section.id }}"
        class="grid product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid--{{ section.settings.columns_desktop }}-col-desktop grid--2-col-tablet-down{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %}"
        role="list"
        aria-label="{{ section.settings.heading | default: 'Best sellers' | escape }}"
      >
        {%- assign skip_card_product_styles = false -%}
        {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
          {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="grid__item{% if show_mobile_slider %} slider__slide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: 'default',
                lazy_load: true,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: false,
                show_rating: section.settings.show_rating,
                skip_styles: skip_card_product_styles,
                section_id: section.id,
                quick_add: section.settings.quick_add
              %}
            </li>
            {%- assign skip_card_product_styles = true -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..section.settings.columns_desktop) -%}
            <li class="grid__item{% if show_mobile_slider %} slider__slide{% endif %}">
              {%- assign placeholder_image = 'product-jewelry-' | append: forloop.index -%}
              {% render 'card-product',
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: 'default',
                lazy_load: true,
                placeholder_image: placeholder_image,
                show_rating: false,
                quick_add: 'none',
                section_id: section.id,
                skip_styles: skip_card_product_styles
              %}
            </li>
            {%- assign skip_card_product_styles = true -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>

      {%- if show_mobile_slider -%}
        <div class="slider-buttons small-hide medium-hide">
          <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="Slider-{{ section.id }}">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ products_to_display }}</span>
          </div>
          <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="Slider-{{ section.id }}">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>

    {%- if section.settings.show_view_all and section.settings.collection != blank -%}
      <div class="suvedh-best-sellers__view-all center">
        <a class="button{% if section.settings.view_all_style == 'outline' %} button--secondary{% endif %}" href="{{ section.settings.collection.url }}" aria-label="View all {{ section.settings.collection.title | escape }} products">
          {{ section.settings.view_all_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "SUVEDH Best Sellers",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "SUVEDH Best Sellers" },
    { "type": "richtext", "id": "subtitle", "label": "Subtitle", "default": "<p>Our most-loved sterling silver pieces, chosen by you.</p>" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Product limit", "default": 8 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 6, "step": 1, "label": "Desktop columns", "default": 4 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "square"
    },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Show second image on hover", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Show product rating", "info": "Ratings appear only for products with rating metafields.", "default": true },
    {
      "type": "select",
      "id": "quick_add",
      "label": "Quick add",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" }
      ],
      "default": "standard"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view-all button", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View-all label", "default": "View all best sellers" },
    {
      "type": "select",
      "id": "view_all_style",
      "label": "View-all style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "outline"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "presets": [{ "name": "SUVEDH Best Sellers" }]
}
{% endschema %}
