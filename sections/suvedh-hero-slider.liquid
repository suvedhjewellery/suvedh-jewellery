{%- style -%}
  #shopify-section-{{ section.id }} .suvedh-hero-slider {
    height: {{ section.settings.desktop_height }}px;
  }

  #SuvedhHero-{{ section.id }} {
    --hero-height-mobile: {{ section.settings.mobile_height }}px;
    --hero-height-desktop: {{ section.settings.desktop_height }}px;
    --hero-mobile-position: {{ section.settings.mobile_image_position }};
    --hero-desktop-position: {{ section.settings.desktop_image_position }};
    --hero-control-background: {{ section.settings.control_background }};
    --hero-control-color: {{ section.settings.control_color }};
    position: relative;
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    box-sizing: border-box;
  }

  #SuvedhHero-{{ section.id }} .suvedh-hero__viewport,
  #SuvedhHero-{{ section.id }} .suvedh-hero__track,
  #SuvedhHero-{{ section.id }} .suvedh-hero__slide,
  #SuvedhHero-{{ section.id }} .suvedh-hero__media,
  #SuvedhHero-{{ section.id }} .suvedh-hero__media picture,
  #SuvedhHero-{{ section.id }} .suvedh-hero__image,
  #SuvedhHero-{{ section.id }} .suvedh-hero__placeholder {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  #SuvedhHero-{{ section.id }} .suvedh-hero__viewport,
  #SuvedhHero-{{ section.id }} .suvedh-hero__slide,
  #SuvedhHero-{{ section.id }} .suvedh-hero__media,
  #SuvedhHero-{{ section.id }} .suvedh-hero__media picture {
    overflow: hidden;
  }
  #SuvedhHero-{{ section.id }} .suvedh-hero__track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    transition: transform 500ms ease;
    touch-action: pan-y;
  }
  #SuvedhHero-{{ section.id }} .suvedh-hero__slide {
    position: relative;
    flex: 0 0 100%;
    min-width: 0;
    height: var(--hero-height-mobile);
    overflow: hidden;
    background: rgb(var(--color-background));
  }
  #SuvedhHero-{{ section.id }} .suvedh-hero__media,
  #SuvedhHero-{{ section.id }} .suvedh-hero__media picture,
  #SuvedhHero-{{ section.id }} .suvedh-hero__image,
  #SuvedhHero-{{ section.id }} .suvedh-hero__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }
  #SuvedhHero-{{ section.id }} .suvedh-hero__image {
    object-fit: cover;
    object-position: var(--hero-mobile-position);
  }
  #SuvedhHero-{{ section.id }} .suvedh-hero__placeholder { background: rgb(var(--color-background)); }
  #SuvedhHero-{{ section.id }} .suvedh-hero__overlay {
    position: absolute;
    inset: 0;
    background: #000;
    pointer-events: none;
  }
  #SuvedhHero-{{ section.id }} .suvedh-hero__content {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    padding: 3rem 2rem 6rem;
    color: var(--slide-text-color);
    overflow: hidden;
    overflow-wrap: anywhere;
  }
  #SuvedhHero-{{ section.id }} .suvedh-hero__content--top-left { align-items: flex-start; justify-content: flex-start; }
  #SuvedhHero-{{ section.id }} .suvedh-hero__content--top-center { align-items: flex-start; justify-content: center; }
  #SuvedhHero-{{ section.id }} .suvedh-hero__content--top-right { align-items: flex-start; justify-content: flex-end; }
  #SuvedhHero-{{ section.id }} .suvedh-hero__content--middle-left { align-items: center; justify-content: flex-start; }
  #SuvedhHero-{{ section.id }} .suvedh-hero__content--middle-center { align-items: center; justify-content: center; }
  #SuvedhHero-{{ section.id }} .suvedh-hero__content--middle-right { align-items: center; justify-content: flex-end; }
  #SuvedhHero-{{ section.id }} .suvedh-hero__content--bottom-left { align-items: flex-end; justify-content: flex-start; }
  #SuvedhHero-{{ section.id }} .suvedh-hero__content--bottom-center { align-items: flex-end; justify-content: center; }
  #SuvedhHero-{{ section.id }} .suvedh-hero__content--bottom-right { align-items: flex-end; justify-content: flex-end; }
  #SuvedhHero-{{ section.id }} .suvedh-hero__box { width: min(100%, 60rem); }
  #SuvedhHero-{{ section.id }} .suvedh-hero__box--left { text-align: left; }
  #SuvedhHero-{{ section.id }} .suvedh-hero__box--center { text-align: center; }
  #SuvedhHero-{{ section.id }} .suvedh-hero__box--right { text-align: right; }
  #SuvedhHero-{{ section.id }} .suvedh-hero__heading {
    max-width: 90%;
    margin: 0 0 1rem;
    color: inherit;
  }
  #SuvedhHero-{{ section.id }} .suvedh-hero__subheading { margin: 0 0 2rem; font-size: 1.6rem; }
  #SuvedhHero-{{ section.id }} .suvedh-hero__logo {
    position: absolute;
    z-index: 2;
    top: 2rem;
    left: 50%;
    width: min(38vw, 18rem);
    height: auto;
    transform: translateX(-50%);
  }
  #SuvedhHero-{{ section.id }} .suvedh-hero__controls {
    position: absolute;
    z-index: 2;
    right: 1.5rem;
    bottom: 1.5rem;
    left: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    pointer-events: none;
  }
  #SuvedhHero-{{ section.id }} .suvedh-hero__arrow,
  #SuvedhHero-{{ section.id }} .suvedh-hero__dot {
    border: 0;
    background: var(--hero-control-background);
    color: var(--hero-control-color);
    cursor: pointer;
    pointer-events: auto;
  }
  #SuvedhHero-{{ section.id }} .suvedh-hero__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    font-size: 2rem;
  }
  #SuvedhHero-{{ section.id }} .suvedh-hero__dots { display: flex; gap: .8rem; }
  #SuvedhHero-{{ section.id }} .suvedh-hero__dot {
    width: 1rem;
    height: 1rem;
    padding: 0;
    border-radius: 50%;
    opacity: .55;
  }
  #SuvedhHero-{{ section.id }} .suvedh-hero__dot[aria-current='true'] { opacity: 1; transform: scale(1.25); }
  #SuvedhHero-{{ section.id }} button:focus-visible,
  #SuvedhHero-{{ section.id }} a:focus-visible { outline: .2rem solid currentColor; outline-offset: .3rem; }

  @media screen and (min-width: 750px) {
    #SuvedhHero-{{ section.id }} .suvedh-hero__slide {
      height: var(--hero-height-desktop);
    }
    #SuvedhHero-{{ section.id }} .suvedh-hero__image {
      object-position: var(--hero-desktop-position);
    }
    #SuvedhHero-{{ section.id }} .suvedh-hero__content { padding: 5rem 7rem 7rem; }
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} .suvedh-hero-slider,
    #SuvedhHero-{{ section.id }},
    #SuvedhHero-{{ section.id }} .suvedh-hero__viewport,
    #SuvedhHero-{{ section.id }} .suvedh-hero__track,
    #SuvedhHero-{{ section.id }} .suvedh-hero__slide,
    #SuvedhHero-{{ section.id }} .suvedh-hero__media,
    #SuvedhHero-{{ section.id }} .suvedh-hero__media picture,
    #SuvedhHero-{{ section.id }} .suvedh-hero__image {
      width: 100%;
      max-width: 100%;
      height: auto;
      min-height: 0;
      margin-top: 0;
      margin-bottom: 0;
      padding-top: 0;
      padding-bottom: 0;
    }
    #shopify-section-{{ section.id }} + .section {
      margin-top: 0;
    }
    #SuvedhHero-{{ section.id }} .suvedh-hero__viewport,
    #SuvedhHero-{{ section.id }} .suvedh-hero__track {
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .suvedh-hero-slider,
    #SuvedhHero-{{ section.id }} .suvedh-hero__viewport,
    #SuvedhHero-{{ section.id }} .suvedh-hero__track,
    #SuvedhHero-{{ section.id }} .suvedh-hero__slide,
    #SuvedhHero-{{ section.id }} .suvedh-hero__media,
    #SuvedhHero-{{ section.id }} .suvedh-hero__media picture,
    #SuvedhHero-{{ section.id }} .suvedh-hero__image {
      height: min(460px, 70vh);
    }
    #SuvedhHero-{{ section.id }} .suvedh-hero__image {
      object-fit: var(--hero-mobile-fit);
      object-position: var(--hero-mobile-object-position);
    }
    #SuvedhHero-{{ section.id }} .suvedh-hero__media {
      background-color: var(--hero-mobile-background);
    }
    #SuvedhHero-{{ section.id }} .suvedh-hero__content {
      box-sizing: border-box;
      max-height: 100%;
      min-height: 0;
      padding: 3.2rem 2rem 4.8rem;
      overflow: hidden;
    }
    #SuvedhHero-{{ section.id }} .suvedh-hero__box {
      max-height: 100%;
      min-height: 0;
      overflow-y: auto;
    }
    #SuvedhHero-{{ section.id }} .suvedh-hero__heading { font-size: clamp(28px, 8vw, 44px) !important; }
    #SuvedhHero-{{ section.id }} .suvedh-hero__subheading { font-size: clamp(14px, 3.8vw, 17px) !important; }
    #SuvedhHero-{{ section.id }} .suvedh-hero__box--mobile-left { text-align: left; }
    #SuvedhHero-{{ section.id }} .suvedh-hero__box--mobile-center { text-align: center; }
    #SuvedhHero-{{ section.id }} .suvedh-hero__box--mobile-right { text-align: right; }
    #SuvedhHero-{{ section.id }} .suvedh-hero__box--mobile-left .suvedh-hero__buttons { align-items: flex-start; }
    #SuvedhHero-{{ section.id }} .suvedh-hero__box--mobile-center .suvedh-hero__buttons { align-items: center; }
    #SuvedhHero-{{ section.id }} .suvedh-hero__box--mobile-right .suvedh-hero__buttons { align-items: flex-end; }
    #SuvedhHero-{{ section.id }} .suvedh-hero__box--mobile-center .suvedh-hero__heading { margin-inline: auto; }
    #SuvedhHero-{{ section.id }} .suvedh-hero__box--mobile-right .suvedh-hero__heading { margin-left: auto; }
    #SuvedhHero-{{ section.id }} .suvedh-hero__buttons { flex-direction: column; align-items: inherit; gap: 12px; }
    #SuvedhHero-{{ section.id }} .suvedh-hero__buttons .button { width: auto; max-width: 90%; min-width: 0; }
    #SuvedhHero-{{ section.id }} .suvedh-hero__controls { position: absolute; min-height: 0; padding: 0; }
    #SuvedhHero-{{ section.id }} .suvedh-hero__arrow { display: inline-flex !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    #SuvedhHero-{{ section.id }} .suvedh-hero__track { transition: none; }
  }
{%- endstyle -%}

<suvedh-hero-slider
  id="SuvedhHero-{{ section.id }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_label | escape }}"
  data-autoplay="{{ section.settings.auto_rotate }}"
  data-speed="{{ section.settings.rotation_speed | times: 1000 }}"
>
  <div class="suvedh-hero-slider suvedh-hero__viewport">
    <div class="suvedh-hero__track" id="SuvedhHeroTrack-{{ section.id }}" aria-live="polite">
      {%- for block in section.blocks -%}
        {%- liquid
          assign desktop_image = block.settings.desktop_image
          assign mobile_image = block.settings.mobile_image | default: desktop_image
          assign fallback_image = desktop_image | default: mobile_image
          assign mobile_image_fit = block.settings.mobile_image_fit | default: 'cover'
          assign mobile_background = block.settings.mobile_background | default: '#F9E9EC'
          assign image_alt = fallback_image.alt | default: section.settings.accessibility_label
          assign image_loading = 'lazy'
          assign image_priority = 'auto'
          if forloop.first
            assign image_loading = 'eager'
            assign image_priority = 'high'
          endif
        -%}
        <article
          class="suvedh-hero__slide suvedh-hero__slide--mobile-{{ mobile_image_fit }}"
          id="SuvedhHeroSlide-{{ section.id }}-{{ forloop.index }}"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} of {{ forloop.length }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          style="--hero-mobile-fit: {{ mobile_image_fit }}; --hero-mobile-background: {{ mobile_background }}; --hero-mobile-object-position: {% if mobile_image_fit == 'cover' %}{{ block.settings.mobile_horizontal_position | default: 'center' }} {{ block.settings.mobile_vertical_position | default: 'center' }}{% else %}center center{% endif %};"
          {{ block.shopify_attributes }}
        >
          <div class="suvedh-hero__media">
            <picture>
              {%- if mobile_image != blank -%}
                <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 550 }} 550w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw">
              {%- endif -%}
              {%- if fallback_image != blank -%}
                <img
                  class="suvedh-hero__image"
                  src="{{ fallback_image | image_url: width: 1500 }}"
                  srcset="{{ fallback_image | image_url: width: 750 }} 750w, {{ fallback_image | image_url: width: 1100 }} 1100w, {{ fallback_image | image_url: width: 1500 }} 1500w, {{ fallback_image | image_url: width: 2000 }} 2000w, {{ fallback_image | image_url: width: 2400 }} 2400w"
                  sizes="100vw"
                  alt="{{ image_alt | escape }}"
                  width="{{ fallback_image.width }}"
                  height="{{ fallback_image.height }}"
                  loading="{{ image_loading }}"
                  fetchpriority="{{ image_priority }}"
                >
              {%- else -%}
                <img
                  class="suvedh-hero__image"
                  src="{{ 'suvedh-hero-desktop.png' | asset_url }}"
                  sizes="100vw"
                  alt="{{ image_alt | escape }}"
                  width="1536"
                  height="1024"
                  loading="{{ image_loading }}"
                  fetchpriority="{{ image_priority }}"
                >
              {%- endif -%}
            </picture>
          </div>
          {%- if block.settings.content_mode == 'overlay' -%}
            {%- if block.settings.show_overlay_logo and block.settings.overlay_logo != blank -%}
              {{ block.settings.overlay_logo | image_url: width: 360 | image_tag: class: 'suvedh-hero__logo', loading: image_loading, widths: '120, 180, 240, 360', alt: block.settings.overlay_logo.alt }}
            {%- endif -%}
            <div class="suvedh-hero__overlay" style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"></div>
            <div class="suvedh-hero__content suvedh-hero__content--{{ block.settings.text_position }}" style="--slide-text-color: {{ block.settings.text_color }};">
              <div class="suvedh-hero__box suvedh-hero__box--{{ block.settings.text_alignment }} suvedh-hero__box--mobile-{{ block.settings.mobile_text_alignment }}">
              {%- if block.settings.eyebrow != blank -%}<p class="suvedh-hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
              {%- if block.settings.heading != blank -%}<h2 class="suvedh-hero__heading {{ block.settings.heading_size }}">{{ block.settings.heading }}</h2>{%- endif -%}
              {%- if block.settings.subheading != blank -%}<div class="suvedh-hero__subheading rte">{{ block.settings.subheading }}</div>{%- endif -%}
              <div class="suvedh-hero__buttons">
                {%- if block.settings.button_label != blank -%}<a class="button button--{{ block.settings.button_style }}" {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ block.settings.button_label | escape }}</a>{%- endif -%}
                {%- if block.settings.second_button_label != blank -%}<a class="button button--secondary" {% if block.settings.second_button_link != blank %}href="{{ block.settings.second_button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ block.settings.second_button_label | escape }}</a>{%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="suvedh-hero__controls">
      <button class="suvedh-hero__arrow" type="button" data-previous aria-label="Previous slide" aria-controls="SuvedhHeroTrack-{{ section.id }}">&#8249;</button>
      <div class="suvedh-hero__dots" role="group" aria-label="Choose slide">
        {%- for block in section.blocks -%}
          <button class="suvedh-hero__dot" type="button" data-slide="{{ forloop.index0 }}" aria-label="Show slide {{ forloop.index }} of {{ forloop.length }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
        {%- endfor -%}
      </div>
      <button class="suvedh-hero__arrow" type="button" data-next aria-label="Next slide" aria-controls="SuvedhHeroTrack-{{ section.id }}">&#8250;</button>
    </div>
  {%- endif -%}
</suvedh-hero-slider>

<script>
  if (!customElements.get('suvedh-hero-slider')) {
    customElements.define('suvedh-hero-slider', class extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.suvedh-hero__track');
        this.slides = [...this.querySelectorAll('.suvedh-hero__slide')];
        this.dots = [...this.querySelectorAll('.suvedh-hero__dot')];
        if (this.slides.length < 2) return;
        this.index = 0;
        this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.autoplay = this.dataset.autoplay === 'true';
        this.speed = Number(this.dataset.speed) || 5000;
        this.querySelector('[data-previous]').addEventListener('click', () => this.show(this.index - 1, true));
        this.querySelector('[data-next]').addEventListener('click', () => this.show(this.index + 1, true));
        this.dots.forEach((dot) => dot.addEventListener('click', () => this.show(Number(dot.dataset.slide), true)));
        this.addEventListener('mouseenter', () => this.pause());
        this.addEventListener('mouseleave', () => this.play());
        this.addEventListener('focusin', () => this.pause());
        this.addEventListener('focusout', (event) => { if (!this.contains(event.relatedTarget)) this.play(); });
        this.addEventListener('pointerdown', (event) => { if (event.pointerType === 'touch') this.touchStart = event.clientX; });
        this.addEventListener('pointerup', (event) => {
          if (this.touchStart == null || event.pointerType !== 'touch') return;
          const distance = event.clientX - this.touchStart;
          if (Math.abs(distance) > 50) this.show(this.index + (distance < 0 ? 1 : -1), true);
          this.touchStart = null;
        });
        this.reducedMotion.addEventListener('change', () => this.play());
        this.play();
      }
      show(index, userInitiated = false) {
        this.index = (index + this.slides.length) % this.slides.length;
        this.track.style.transform = `translateX(-${this.index * 100}%)`;
        this.slides.forEach((slide, i) => {
          const active = i === this.index;
          slide.setAttribute('aria-hidden', String(!active));
          slide.querySelectorAll('a, button').forEach((element) => {
            if (active) {
              element.removeAttribute('tabindex');
            } else {
              element.setAttribute('tabindex', '-1');
            }
          });
        });
        this.dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === this.index)));
        if (userInitiated) { this.pause(); this.play(); }
      }
      play() {
        this.pause();
        if (!this.autoplay || this.reducedMotion.matches || this.matches(':hover') || this.contains(document.activeElement)) return;
        this.track.setAttribute('aria-live', 'off');
        this.timer = setInterval(() => this.show(this.index + 1), this.speed);
      }
      pause() {
        clearInterval(this.timer);
        if (this.track) this.track.setAttribute('aria-live', 'polite');
      }
      disconnectedCallback() { this.pause(); }
    });
  }
</script>

{% schema %}
{
  "name": "SUVEDH Hero Slider",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Featured promotions" },
    { "type": "checkbox", "id": "auto_rotate", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "rotation_speed", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Rotation speed", "default": 5 },
    { "type": "range", "id": "desktop_height", "label": "Desktop hero height", "min": 400, "max": 900, "step": 10, "default": 620, "unit": "px" },
    { "type": "range", "id": "mobile_height", "label": "Mobile hero height", "min": 300, "max": 900, "step": 10, "default": 620, "unit": "px" },
    { "type": "select", "id": "desktop_image_position", "label": "Desktop image position", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }], "default": "center center" },
    { "type": "select", "id": "mobile_image_position", "label": "Mobile image position", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }], "default": "center center" },
    { "type": "color", "id": "control_background", "label": "Control background", "default": "#ffffff" },
    { "type": "color", "id": "control_color", "label": "Control color", "default": "#1a1a1a" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "select", "id": "mobile_image_fit", "label": "Mobile image fit", "options": [{ "value": "contain", "label": "Contain - show complete image" }, { "value": "cover", "label": "Cover - fill banner and allow cropping" }], "default": "cover" },
        { "type": "color", "id": "mobile_background", "label": "Mobile banner background", "default": "#F9E9EC" },
        { "type": "select", "id": "mobile_horizontal_position", "label": "Mobile horizontal position", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
        { "type": "select", "id": "mobile_vertical_position", "label": "Mobile vertical position", "options": [{ "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" }], "default": "center" },

        { "type": "select", "id": "content_mode", "label": "Content mode", "options": [{ "value": "image_only", "label": "Image only" }, { "value": "overlay", "label": "Image with overlay text" }], "default": "image_only" },
        { "type": "checkbox", "id": "show_overlay_logo", "label": "Show overlay logo", "default": false },
        { "type": "image_picker", "id": "overlay_logo", "label": "Overlay logo image" },
        { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 20 },
