{%- style -%}
#shopify-section-{{ section.id }}{width:100vw;max-width:none;margin-right:calc(50% - 50vw);margin-left:calc(50% - 50vw)}
#SuvedhHero-{{ section.id }}{--hero-control-background:{{ section.settings.control_background }};--hero-control-color:{{ section.settings.control_color }};position:relative;width:100%;height:{{ section.settings.desktop_height }}px;overflow:hidden}
#SuvedhHero-{{ section.id }} .suvedh-hero__slide{position:absolute;inset:0;opacity:0;visibility:hidden;pointer-events:none;transition:opacity 500ms ease}
#SuvedhHero-{{ section.id }} .suvedh-hero__slide.is-active{opacity:1;visibility:visible;pointer-events:auto}
#SuvedhHero-{{ section.id }} picture,#SuvedhHero-{{ section.id }} .suvedh-hero__image{display:block;width:100%;height:100%}
#SuvedhHero-{{ section.id }} .suvedh-hero__image{object-fit:cover;object-position:{{ section.settings.desktop_image_position }}}
#SuvedhHero-{{ section.id }} .suvedh-hero__controls{position:absolute;z-index:2;inset:0;pointer-events:none}
#SuvedhHero-{{ section.id }} .suvedh-hero__arrow,#SuvedhHero-{{ section.id }} .suvedh-hero__dot{border:0;color:var(--hero-control-color);cursor:pointer;pointer-events:auto}
#SuvedhHero-{{ section.id }} .suvedh-hero__arrow{position:absolute;top:50%;display:inline-flex;align-items:center;justify-content:center;width:4.4rem;height:4.4rem;padding:0;background:transparent;box-shadow:none;font-size:2rem;transform:translateY(-50%)}
#SuvedhHero-{{ section.id }} [data-previous]{left:1.5rem}#SuvedhHero-{{ section.id }} [data-next]{right:1.5rem}
#SuvedhHero-{{ section.id }} .suvedh-hero__dots{position:absolute;bottom:1.5rem;left:50%;display:flex;gap:.8rem;transform:translateX(-50%);pointer-events:auto}
#SuvedhHero-{{ section.id }} .suvedh-hero__dot{width:1rem;height:1rem;padding:0;border-radius:50%;background:var(--hero-control-background);opacity:.55}
#SuvedhHero-{{ section.id }} .suvedh-hero__dot[aria-current=true]{opacity:1;transform:scale(1.25)}
#SuvedhHero-{{ section.id }} button:focus-visible{outline:.2rem solid currentColor;outline-offset:.3rem}
@media(max-width:749px){#SuvedhHero-{{ section.id }}{height:{{ section.settings.mobile_height }}px}#SuvedhHero-{{ section.id }} .suvedh-hero__image{object-position:{{ section.settings.mobile_image_position }}}}
@media(prefers-reduced-motion:reduce){#SuvedhHero-{{ section.id }} .suvedh-hero__slide{transition:none}}
{%- endstyle -%}
<div id="SuvedhHero-{{ section.id }}" class="suvedh-hero-slider" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.accessibility_label | escape }}" data-suvedh-hero>
  <div class="suvedh-hero__slide is-active" role="group" aria-roledescription="slide" aria-label="1 of 2" aria-hidden="false">
    <picture>
      <source media="(max-width: 749px)" srcset="{{ 'suvedh-hero-mobile-01.png' | asset_url }}">
      <img class="suvedh-hero__image" src="{{ 'suvedh-hero-desktop-01.png' | asset_url }}" alt="" width="1350" height="505" loading="eager" fetchpriority="high">
    </picture>
  </div>
  <div class="suvedh-hero__slide" role="group" aria-roledescription="slide" aria-label="2 of 2" aria-hidden="true">
    <picture>
      <source media="(max-width: 749px)" srcset="{{ 'suvedh-hero-mobile-02.png' | asset_url }}">
      <img class="suvedh-hero__image" src="{{ 'suvedh-hero-desktop-02.png' | asset_url }}" alt="" width="1350" height="505" loading="eager">
    </picture>
  </div>
  <div class="suvedh-hero__controls">
    <button class="suvedh-hero__arrow" type="button" data-previous aria-label="Previous slide">&#8249;</button>
    <div class="suvedh-hero__dots" role="group" aria-label="Choose slide">
      <button class="suvedh-hero__dot" type="button" data-slide="0" aria-label="Show slide 1 of 2" aria-current="true"></button>
      <button class="suvedh-hero__dot" type="button" data-slide="1" aria-label="Show slide 2 of 2" aria-current="false"></button>
    </div>
    <button class="suvedh-hero__arrow" type="button" data-next aria-label="Next slide">&#8250;</button>
  </div>
</div>
<script>
(()=>{
  const init=hero=>{
    if(!hero)return;
    if(typeof hero.suvedhHeroCleanup==='function')hero.suvedhHeroCleanup();
    const slides=[...hero.querySelectorAll('.suvedh-hero__slide')];
    const dots=[...hero.querySelectorAll('.suvedh-hero__dot')];
    const previous=hero.querySelector('[data-previous]');
    const next=hero.querySelector('[data-next]');
    let index=0,timer=null,touchStartX=null;
    const show=newIndex=>{
      index=(newIndex+slides.length)%slides.length;
      slides.forEach((slide,i)=>{const active=i===index;slide.classList.toggle('is-active',active);slide.setAttribute('aria-hidden',String(!active))});
      dots.forEach((dot,i)=>dot.setAttribute('aria-current',String(i===index)));
    };
    const stop=()=>{if(timer!==null)window.clearInterval(timer);timer=null};
    const start=()=>{stop();timer=window.setInterval(()=>show(index+1),5000)};
    const navigate=newIndex=>{show(newIndex);start()};
    const onPrevious=()=>navigate(index-1);
    const onNext=()=>navigate(index+1);
    const onTouchStart=event=>{touchStartX=event.touches[0].clientX};
    const onTouchEnd=event=>{
      if(touchStartX===null||!event.changedTouches.length)return;
      const distance=event.changedTouches[0].clientX-touchStartX;
      touchStartX=null;
      if(Math.abs(distance)>=50)navigate(index+(distance<0?1:-1));
    };
    previous.addEventListener('click',onPrevious);
    next.addEventListener('click',onNext);
    dots.forEach(dot=>{dot.suvedhHeroClick=()=>navigate(Number(dot.dataset.slide));dot.addEventListener('click',dot.suvedhHeroClick)});
    hero.addEventListener('touchstart',onTouchStart,{passive:true});
    hero.addEventListener('touchend',onTouchEnd,{passive:true});
    hero.suvedhHeroCleanup=()=>{
      stop();
      previous.removeEventListener('click',onPrevious);
      next.removeEventListener('click',onNext);
      dots.forEach(dot=>dot.removeEventListener('click',dot.suvedhHeroClick));
      hero.removeEventListener('touchstart',onTouchStart);
      hero.removeEventListener('touchend',onTouchEnd);
    };
    show(0);start();
  };
  const initWithin=container=>{
    if(container.matches&&container.matches('[data-suvedh-hero]'))init(container);
    container.querySelectorAll('[data-suvedh-hero]').forEach(init);
  };
  if(!window.suvedhHeroSectionLoadHandler){
    window.suvedhHeroSectionLoadHandler=event=>initWithin(event.target);
    document.addEventListener('shopify:section:load',window.suvedhHeroSectionLoadHandler);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>initWithin(document),{once:true});
  else initWithin(document);
})();
</script>
{% schema %}
{
  "name": "SUVEDH Hero Slider",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Featured promotions" },
    { "type": "checkbox", "id": "auto_rotate", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "rotation_speed", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Rotation speed", "default": 5 },
    { "type": "range", "id": "desktop_height", "label": "Desktop hero height", "min": 400, "max": 900, "step": 10, "default": 620, "unit": "px" },
    { "type": "range", "id": "mobile_height", "label": "Mobile hero height", "min": 300, "max": 900, "step": 10, "default": 620, "unit": "px" },
    { "type": "select", "id": "desktop_image_position", "label": "Desktop image position", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }], "default": "center center" },
    { "type": "select", "id": "mobile_image_position", "label": "Mobile image position", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }], "default": "center center" },
    { "type": "color", "id": "control_background", "label": "Control background", "default": "#ffffff" },
    { "type": "color", "id": "control_color", "label": "Control color", "default": "#1a1a1a" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "select", "id": "mobile_image_fit", "label": "Mobile image fit", "options": [{ "value": "contain", "label": "Contain - show complete image" }, { "value": "cover", "label": "Cover - fill banner and allow cropping" }], "default": "cover" },
        { "type": "color", "id": "mobile_background", "label": "Mobile banner background", "default": "#F9E9EC" },
        { "type": "select", "id": "mobile_horizontal_position", "label": "Mobile horizontal position", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
        { "type": "select", "id": "mobile_vertical_position", "label": "Mobile vertical position", "options": [{ "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" }], "default": "center" },

        { "type": "select", "id": "content_mode", "label": "Content mode", "options": [{ "value": "image_only", "label": "Image only" }, { "value": "overlay", "label": "Image with overlay text" }], "default": "image_only" },
        { "type": "checkbox", "id": "show_overlay_logo", "label": "Show overlay logo", "default": false },
        { "type": "image_picker", "id": "overlay_logo", "label": "Overlay logo image" },
        { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 20 },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SUVEDH" },
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Crafted for Every Moment" },
        { "type": "select", "id": "heading_size", "label": "Heading size", "options": [{ "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }, { "value": "h0", "label": "Large" }], "default": "h0" },
        { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Discover authentic 92.5 sterling silver jewellery.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "text", "id": "second_button_label", "label": "Second button label", "default": "Explore Collection" },
        { "type": "url", "id": "second_button_link", "label": "Second button link" },
        { "type": "select", "id": "button_style", "label": "Button style", "options": [{ "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }], "default": "primary" },
        { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
        { "type": "select", "id": "mobile_text_alignment", "label": "Mobile text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
        { "type": "select", "id": "text_position", "label": "Text position", "options": [{ "value": "top-left", "label": "Top left" }, { "value": "top-center", "label": "Top center" }, { "value": "top-right", "label": "Top right" }, { "value": "middle-left", "label": "Middle left" }, { "value": "middle-center", "label": "Middle center" }, { "value": "middle-right", "label": "Middle right" }, { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-center", "label": "Bottom center" }, { "value": "bottom-right", "label": "Bottom right" }], "default": "middle-center" }
      ]
    }
  ],
  "presets": [{ "name": "SUVEDH Hero Slider", "blocks": [{ "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
